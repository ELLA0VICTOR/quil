# Copy to .env locally. These are placeholders; do not commit real keys.
# Node.js 24+ is required. Fixture mode runs Mozaik with no paid requests.
QUIL_MODE=fixture
QUIL_API_PORT=8787
QUIL_DATA_DIR=.quil-data
QUIL_ENABLE_LIVE=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
SERPER_API_KEY=
QUIL_TOTAL_BUDGET_USD=1.50
QUIL_RUN_BUDGET_USD=0.02
QUIL_MAX_MODEL_CALLS=7
QUIL_MAX_SEARCH_REQUESTS=50
QUIL_MAX_SEARCH_PER_RUN=4

# Optional: reviewed Gmail messages and Google Calendar invitations.
# Enable Gmail API + Calendar API, create a Web application OAuth client.
# Full steps: docs/GOOGLE-SETUP.md. Never use VITE_ for these credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/api/google/callback

# Separate ordinary Google sign-in client. Leave its AI-agent checkbox off.
GOOGLE_SIGNIN_CLIENT_ID=
GOOGLE_SIGNIN_CLIENT_SECRET=
GOOGLE_SIGNIN_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
# Set only before public hosting; never include a trailing slash.
QUIL_PUBLIC_ORIGIN=
QUIL_USER_DAILY_BUDGET_USD=0.02
QUIL_USER_DAILY_SEARCH_REQUESTS=20
QUIL_MAX_ACTIVE_RUNS=2
QUIL_PREVIEW_CHAT_TURNS=10
QUIL_PREVIEW_RESEARCH_RUNS=1

# Vercel uses postgres automatically; local development defaults to sqlite.
# Keep the pooled connection string and encryption key server-side.
QUIL_STORAGE=sqlite
DATABASE_URL=
QUIL_GOOGLE_TOKEN_KEY=

# Optional Mozaik Cloud trace view. Pair locally with npm run cloud:pair,
# or put the project key here. Only execution metadata is exported.
QUIL_ENABLE_MOZAIK_CLOUD=false
MOZAIK_API_KEY=
