{
  "name": "quil",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "node --import tsx server/index.ts",
    "cloud:pair": "node scripts/pair-mozaik.mjs",
    "migrate:neon": "node --import tsx scripts/migrate-neon.ts",
    "dev": "vite",
    "dev:all": "node scripts/dev.mjs",
    "dev:api": "tsx watch server/index.ts",
    "start:api": "tsx server/index.ts",
    "demo:api": "tsx scripts/backend-demo.ts",
    "check:api": "tsc -p server/tsconfig.json",
    "test:api": "tsx --test server/tests/*.test.ts",
    "test": "npm run test:api",
    "test:browser": "node --import tsx scripts/browser-check.mjs",
    "build": "tsc -b && tsc -p server/tsconfig.json && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@mozaik-ai/core": "4.2.0-beta.18",
    "@vercel/functions": "3.10.5",
    "google-auth-library": "10.9.1",
    "pg": "8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "tsx": "4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
